# Example environment variables - Copy to .env and modify
# 仅包含敏感/部署专用配置，非敏感业务参数请修改 config/ 下的 TOML 文件

# ── 应用环境 ──
# 注意：APP_ENV 决定加载哪个 config/*.toml 覆盖文件，必须在 TOML 加载之前确定，
# 因此只能通过环境变量注入，无法在 TOML 中定义。
APP_ENV=development  # development | testing | production

# ── 数据库 ──

# 应用连接串
DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/agent_monitor

# ── 测试专用（pytest / just test 使用，不用于生产部署） ──

# 测试数据库连接串；pytest 与 Just 测试工作流会读取此变量
TEST_DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/agent_monitor_test

# ── Redis（敏感，不提交真实值） ──
REDIS_URL=

# ── Metrics VictoriaMetrics（敏感/部署相关，不提交真实值） ──
VM_QUERY_URL=
VM_REMOTE_WRITE_URL=

# ── Access ClickHouse（敏感/部署相关，不提交真实值） ──
# 默认连接本地 dev-infra ClickHouse：./dev-infra.sh up clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=amp

# ── Access MinIO（Parquet 冷归档对象存储，archive_enabled=true 时生效） ──
# 默认连接本地 dev-infra MinIO：./dev-infra.sh up minio
# API: http://localhost:19000  Console: http://localhost:19001 (admin/devpass)
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=devpass

# ── System OpenSearch（真相源，默认连接本地 dev-infra OpenSearch） ──
# 启动：cd acps-infra && ./dev-infra/dev-infra.sh up opensearch
OPENSEARCH_HOSTS=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

# ── OIDC（真人登录） ──
# OIDC 常规参数属于非敏感运行配置，请在 config/*.toml 的 [oidc] 段中维护。
# 如部署系统确需临时覆写，可按需自行添加 MONITOR_OIDC_* 环境变量。
