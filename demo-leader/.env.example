# 应用运行环境
APP_ENV=development

# 除 LLM 外的非敏感运行配置统一维护在 leader/config.toml：
# - [uvicorn] Leader API 监听地址
# - [web] Web UI 监听地址
# - [discovery] 动态发现服务地址
# - [rabbitmq] RabbitMQ / MQ Auth 访问地址

# LLM（敏感项，按实际注入）
LEADER_LLM_DEFAULT_API_KEY=
LEADER_LLM_DEFAULT_BASE_URL=
LEADER_LLM_DEFAULT_MODEL=
LEADER_LLM_FAST_API_KEY=
LEADER_LLM_FAST_BASE_URL=
LEADER_LLM_FAST_MODEL=
LEADER_LLM_PRO_API_KEY=
LEADER_LLM_PRO_BASE_URL=
LEADER_LLM_PRO_MODEL=

# 本地开发默认 OIDC 配置已提交到：
# - leader/config.toml
# - web_app/runtime-config.js
#
# `.env` 不负责日常 OIDC 开关和固定地址；如需临时覆盖，再按需额外导出：
# - LEADER_OIDC_ENABLED
# - LEADER_OIDC_ISSUER
# - LEADER_OIDC_AUDIENCE
# - LEADER_OIDC_ALLOWED_AZP
# - LEADER_OIDC_CLIENT_ID
# - LEADER_OIDC_ALGORITHMS
# - LEADER_OIDC_REQUIRE_HTTPS
# - LEADER_OIDC_ROLE_SOURCE_CLIENT_ID
