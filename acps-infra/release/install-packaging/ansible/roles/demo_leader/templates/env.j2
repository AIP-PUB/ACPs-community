APP_ENV=production
WEB_PORT={{ demo_leader_web_port | default(9030) }}
{% set rmq_h = 'rabbitmq' if (inventory_hostname in (groups['rabbitmq'] | default([]))) else _rmq_host %}
{% set reg_h = 'registry_server' if (inventory_hostname in (groups['registry_server'] | default([]))) else _registry_host %}
{% set ca_h = 'ca_server' if (inventory_hostname in (groups['ca_server'] | default([]))) else _ca_host %}
{% set disc_h = 'discovery_server' if (inventory_hostname in (groups['discovery_server'] | default([]))) else _discovery_host %}
{#Compose service is mq_auth_server; cert SAN / network alias is mq-auth-server.#}
{% set mq_h = 'mq-auth-server' if (inventory_hostname in (groups['mq_auth_server'] | default([]))) else _mq_host %}
{% set kc_h = 'keycloak' if (inventory_hostname in (groups['keycloak'] | default([]))) else _keycloak_host %}
INFRA_HOST={{ _advertise }}
RABBITMQ_URL=amqps://{{ rmq_h }}:5671/acps?auth=external
RABBITMQ_HOST={{ rmq_h }}
RABBITMQ_PORT=5671
RABBITMQ_VHOST=acps
RABBITMQ_MANAGEMENT_HOST={{ rmq_h }}
RABBITMQ_MANAGEMENT_PORT={{ rabbitmq_mgmt_port | default(15672) }}
REGISTRY_API_BASE_URL=http://{{ reg_h }}:{{ registry_server_public_port }}
CA_SERVER_URL=http://{{ ca_h }}:{{ ca_server_port }}
{# Leader 客户端会自行追加 /discover；base 须含 ADP 前缀 /acps-adp-v2。 #}
DISCOVERY_SERVER_BASE_URL=http://{{ disc_h }}:{{ discovery_server_port }}/acps-adp-v2
MQ_AUTH_URL=https://{{ mq_h }}:{{ mq_auth_server_group_api_port }}
# AMP jsonl directory (must match the compose bind-mount for amp_forwarder).
AMP_LOG_DIR=/opt/acps/app/logs
LEADER_LLM_FAST_API_KEY={{ demo_leader_llm_fast_api_key | default(demo_llm_api_key | default('')) }}
LEADER_LLM_FAST_BASE_URL={{ demo_leader_llm_fast_base_url | default(demo_llm_base_url | default('')) }}
LEADER_LLM_FAST_MODEL={{ demo_leader_llm_fast_model | default(demo_llm_model | default('')) }}
LEADER_LLM_DEFAULT_API_KEY={{ demo_leader_llm_default_api_key | default(demo_llm_api_key | default('')) }}
LEADER_LLM_DEFAULT_BASE_URL={{ demo_leader_llm_default_base_url | default(demo_llm_base_url | default('')) }}
LEADER_LLM_DEFAULT_MODEL={{ demo_leader_llm_default_model | default(demo_llm_model | default('')) }}
LEADER_LLM_PRO_API_KEY={{ demo_leader_llm_pro_api_key | default(demo_llm_api_key | default('')) }}
LEADER_LLM_PRO_BASE_URL={{ demo_leader_llm_pro_base_url | default(demo_llm_base_url | default('')) }}
LEADER_LLM_PRO_MODEL={{ demo_leader_llm_pro_model | default(demo_llm_model | default('')) }}
ACPS_LLM6_FORCE_FALLBACK={{ acps_llm6_force_fallback | default('0') }}
ACPS_GROUP_MAX_WAIT_SECONDS={{ acps_group_max_wait_seconds | default('600') }}
{% if keycloak_enabled | bool %}
LEADER_OIDC_ENABLED=true
LEADER_OIDC_ISSUER=http://{{ _keycloak_public_host }}:{{ keycloak_port }}/realms/acps-leader
LEADER_OIDC_AUDIENCE=leader-api
LEADER_OIDC_ALLOWED_AZP=leader-web,leader-install
LEADER_OIDC_CLIENT_ID=leader-api
LEADER_OIDC_ALGORITHMS=EdDSA
LEADER_OIDC_ROLE_SOURCE_CLIENT_ID=leader-api
LEADER_OIDC_REQUIRE_HTTPS=false
LEADER_WEB_OIDC_ISSUER=http://{{ _keycloak_public_host }}:{{ keycloak_port }}/realms/acps-leader
LEADER_WEB_OIDC_CLIENT_ID=leader-web
LEADER_WEB_OIDC_API_AUDIENCE=leader-api
LEADER_WEB_OIDC_SCOPE=openid profile email
{% else %}
LEADER_OIDC_ENABLED=false
{% endif %}
