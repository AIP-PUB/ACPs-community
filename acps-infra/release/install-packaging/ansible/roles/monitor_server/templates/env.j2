APP_ENV=production
{% set pg_connect_host = 'postgresql' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['postgresql'] | default([]))) else _pg_host %}
DATABASE_URL=postgresql+asyncpg://{{ monitor_db_user | acps_urlquote }}:{{ monitor_db_password | acps_urlquote }}@{{ pg_connect_host }}:5432/{{ monitor_db_name }}
{% set redis_h = 'redis' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['redis'] | default([]))) else _redis_host %}
{% set _redis_ca = (acps_runtime_root ~ '/certs/monitor_server/acps-root-ca.pem') if acps_deploy_mode == 'host' else '/certs/acps-root-ca.pem' %}
{#: mount trust + verify Redis server cert; do not default ssl_cert_reqs=none.#}
REDIS_URL=rediss://:{{ redis_password | acps_urlquote }}@{{ redis_h }}:6379/2?ssl_ca_certs={{ _redis_ca }}&ssl_cert_reqs=required&ssl_check_hostname=false
{% set ch_h = 'clickhouse' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['clickhouse'] | default([]))) else _clickhouse_host %}
{% set os_h = 'opensearch' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['opensearch'] | default([]))) else _opensearch_host %}
{% set vm_h = 'victoria_metrics' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['victoria_metrics'] | default([]))) else _victoria_metrics_host %}
CLICKHOUSE_HOST={{ ch_h }}
CLICKHOUSE_PORT={{ clickhouse_http_port }}
CLICKHOUSE_DATABASE=amp
OPENSEARCH_HOSTS=http://{{ os_h }}:{{ opensearch_http_port }}
OPENSEARCH_VERIFY_CERTS=false
VM_QUERY_URL=http://{{ vm_h }}:{{ victoria_metrics_port }}
VM_REMOTE_WRITE_URL=http://{{ vm_h }}:{{ victoria_metrics_port }}
MINIO_ACCESS_KEY={{ minio_root_user }}
MINIO_SECRET_KEY={{ minio_root_password }}
{#Shared with discovery-server alive-sync; required for Monitor /sync/* when OIDC (Keycloak) is on.#}
HEARTBEAT_SYNC_INTERNAL_TOKEN={{ monitor_heartbeat_sync_internal_token }}
