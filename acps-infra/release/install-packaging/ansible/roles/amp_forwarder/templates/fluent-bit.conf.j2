# AMP Forwarder (install-layer): demo Leader/Partner amp_*.jsonl → Redpanda amp.* topics.
# Log root: {{ _amp_fw_log_base | default('/logs') }} (image bind-mount / host {{ acps_log_root }}).
# State DB: {{ _amp_fw_state_dir | default('/var/lib/fluent-bit') }}.
# Brokers from inventory advertise (B-style); no developer-machine absolute paths.

[SERVICE]
    Flush           1
    Log_Level       info
    Parsers_File    {{ _amp_fw_parsers_file | default('/fluent-bit/etc/parsers.conf') }}

{% if _amp_fw_has_leader | bool %}
# ── demo-leader (fixed filenames) ────────────────────────────────────────────
[INPUT]
    Name             tail
    Path             {{ _amp_fw_log_base | default('/logs') }}/demo_leader/amp_audit.jsonl
    Tag              amp.audit
    Parser           amp_audit_json
    Refresh_Interval 2
    Read_From_Head   False
    DB               {{ _amp_fw_state_dir | default('/var/lib/fluent-bit') }}/leader-audit.db

[INPUT]
    Name             tail
    Path             {{ _amp_fw_log_base | default('/logs') }}/demo_leader/amp_access.jsonl
    Tag              amp.access
    Parser           amp_audit_json
    Refresh_Interval 2
    Read_From_Head   False
    DB               {{ _amp_fw_state_dir | default('/var/lib/fluent-bit') }}/leader-access.db

[INPUT]
