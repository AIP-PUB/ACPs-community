# ── Kafka outputs (Workers 1: required on macOS Fluent Bit v5; fine on Linux) ─
# Brokers: {{ _amp_fw_brokers }}
# timestamp_key _fb_ts on audit only — Monitor AuditWriter strips @/_fb* metadata.
# Non-audit topics expect pre-created LogAppendTime topics; auto-create off.

[OUTPUT]
    Name                              kafka
    Match                             amp.audit
    Brokers                           {{ _amp_fw_brokers }}
    Topics                            amp.audit
    Workers                           1
    timestamp_key                     _fb_ts
    rdkafka.log.connection.close      false
    rdkafka.request.required.acks     1
    rdkafka.allow.auto.create.topics  true

[OUTPUT]
    Name                              kafka
    Match                             amp.access
    Brokers                           {{ _amp_fw_brokers }}
    Topics                            amp.access
    Workers                           1
    rdkafka.log.connection.close      false
    rdkafka.request.required.acks     1
    rdkafka.allow.auto.create.topics  false

[OUTPUT]
    Name                              kafka
    Match                             amp.message
    Brokers                           {{ _amp_fw_brokers }}
    Topics                            amp.message
    Workers                           1
    rdkafka.log.connection.close      false
    rdkafka.request.required.acks     1
    rdkafka.allow.auto.create.topics  false

[OUTPUT]
    Name                              kafka
    Match                             amp.metrics
    Brokers                           {{ _amp_fw_brokers }}
    Topics                            amp.metrics
    Workers                           1
    rdkafka.log.connection.close      false
    rdkafka.request.required.acks     1
    rdkafka.allow.auto.create.topics  false

[OUTPUT]
