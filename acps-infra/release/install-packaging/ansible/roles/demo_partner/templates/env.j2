APP_ENV=production
{% set rmq_h = 'rabbitmq' if (inventory_hostname in (groups['rabbitmq'] | default([]))) else _rmq_host %}
{% set reg_h = 'registry_server' if (inventory_hostname in (groups['registry_server'] | default([]))) else _registry_host %}
{% set ca_h = 'ca_server' if (inventory_hostname in (groups['ca_server'] | default([]))) else _ca_host %}
{% set disc_h = 'discovery_server' if (inventory_hostname in (groups['discovery_server'] | default([]))) else _discovery_host %}
{#Compose service is mq_auth_server; cert SAN / network alias is mq-auth-server.#}
{% set mq_h = 'mq-auth-server' if (inventory_hostname in (groups['mq_auth_server'] | default([]))) else _mq_host %}
INFRA_HOST={{ _advertise }}
RABBITMQ_URL=amqps://{{ rmq_h }}:5671/acps?auth=external
RABBITMQ_HOST={{ rmq_h }}
RABBITMQ_PORT=5671
RABBITMQ_VHOST=acps
REGISTRY_API_BASE_URL=http://{{ reg_h }}:{{ registry_server_public_port }}
CA_SERVER_URL=http://{{ ca_h }}:{{ ca_server_port }}
{# Partner 若走动态发现，base 须含 ADP 前缀 /acps-adp-v2（客户端会追加 /discover）。 #}
DISCOVERY_SERVER_BASE_URL=http://{{ disc_h }}:{{ discovery_server_port }}/acps-adp-v2
MQ_AUTH_URL=https://{{ mq_h }}:{{ mq_auth_server_group_api_port }}
# AMP jsonl directory (must match the compose bind-mount for amp_forwarder).
AMP_LOG_DIR=/opt/acps/app/logs
PARTNER_LLM_FAST_API_KEY={{ demo_partner_llm_fast_api_key | default(demo_llm_api_key | default('')) }}
PARTNER_LLM_FAST_BASE_URL={{ demo_partner_llm_fast_base_url | default(demo_llm_base_url | default('')) }}
PARTNER_LLM_FAST_MODEL={{ demo_partner_llm_fast_model | default(demo_llm_model | default('')) }}
PARTNER_LLM_DEFAULT_API_KEY={{ demo_partner_llm_default_api_key | default(demo_llm_api_key | default('')) }}
PARTNER_LLM_DEFAULT_BASE_URL={{ demo_partner_llm_default_base_url | default(demo_llm_base_url | default('')) }}
PARTNER_LLM_DEFAULT_MODEL={{ demo_partner_llm_default_model | default(demo_llm_model | default('')) }}
PARTNER_LLM_PRO_API_KEY={{ demo_partner_llm_pro_api_key | default(demo_llm_api_key | default('')) }}
PARTNER_LLM_PRO_BASE_URL={{ demo_partner_llm_pro_base_url | default(demo_llm_base_url | default('')) }}
PARTNER_LLM_PRO_MODEL={{ demo_partner_llm_pro_model | default(demo_llm_model | default('')) }}
PARTNER_FORCE_ACCEPT_DECISION={{ partner_force_accept_decision | default('0') }}
