{#: production when advertise is non-loopback; development only for true loopback.#}
{% set _loopback = (_ca_host | string) in ['127.0.0.1', 'localhost', '::1']
   or (_ca_host | string).startswith('127.') %}
APP_ENV={{ 'development' if _loopback else 'production' }}
{% set pg_connect_host = 'postgresql' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['postgresql'] | default([]))) else _pg_host %}
DATABASE_URL=postgresql+asyncpg://{{ ca_db_user | acps_urlquote }}:{{ ca_db_password | acps_urlquote }}@{{ pg_connect_host }}:{{ postgresql_port }}/{{ ca_db_name }}
REGISTRY_SERVER_INTERNAL_API_TOKEN={{ registry_server_internal_api_token }}
{% set reg_connect = 'registry_server' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['registry_server'] | default([]))) else _registry_host %}
REGISTRY_SERVER_URL=http://{{ reg_connect }}:{{ registry_server_public_port }}/acps-atr-v2
ACME_DIRECTORY_URL=http://{{ _ca_host }}:{{ ca_server_port }}/acps-atr-v2/acme
OCSP_RESPONDER_URL=http://{{ _ca_host }}:{{ ca_server_port }}/acps-atr-v2/ocsp
CRL_DISTRIBUTION_POINT_URL=http://{{ _ca_host }}:{{ ca_server_port }}/acps-atr-v2/crl/current
