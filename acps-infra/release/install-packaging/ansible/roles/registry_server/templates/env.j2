APP_ENV=production
ROOT_PATH=
{% set pg_connect_host = 'postgresql' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['postgresql'] | default([]))) else _pg_host %}
DATABASE_URL=postgresql+asyncpg://{{ registry_db_user | acps_urlquote }}:{{ registry_db_password | acps_urlquote }}@{{ pg_connect_host }}:{{ postgresql_port }}/{{ registry_db_name }}
SECRET_KEY={{ registry_secret_key }}
SM4_ENCRYPTION_KEY={{ registry_sm4_encryption_key }}
AIC_CRC_SALT={{ registry_aic_crc_salt }}
{% if acps_deploy_mode == 'host' %}
UPLOAD_BASE_PATH={{ acps_data_root }}/registry_server/uploads
{% else %}
UPLOAD_BASE_PATH=/data/uploads
{% endif %}
{% set ca_connect_host = 'ca_server' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['ca_server'] | default([]))) else _ca_host %}
CA_SERVER_BASE_URL=http://{{ ca_connect_host }}:{{ ca_server_port }}
REGISTRY_SERVER_INTERNAL_API_TOKEN={{ registry_server_internal_api_token }}
REGISTRY_SERVER_ENABLE_MTLS_LISTENER={{ 'true' if (registry_server_enable_mtls_listener | bool) else 'false' }}
REGISTRY_SERVER_MTLS_PUBLIC_HOST={{ _registry_host }}
REGISTRY_SERVER_MTLS_PORT={{ registry_server_mtls_port }}
{% if acps_deploy_mode == 'host' %}
REGISTRY_SERVER_MTLS_CERT_FILE={{ acps_runtime_root }}/certs/registry_server/server.pem
REGISTRY_SERVER_MTLS_KEY_FILE={{ acps_runtime_root }}/certs/registry_server/server.key
REGISTRY_SERVER_MTLS_CA_CERT_FILE={{ acps_runtime_root }}/certs/registry_server/trust-bundle.pem
{% else %}
REGISTRY_SERVER_MTLS_CERT_FILE=/certs/server.pem
REGISTRY_SERVER_MTLS_KEY_FILE=/certs/server.key
REGISTRY_SERVER_MTLS_CA_CERT_FILE=/certs/trust-bundle.pem
{% endif %}
REGISTRY_ADMIN_USERNAME={{ registry_admin_username }}
REGISTRY_ADMIN_PASSWORD={{ registry_admin_password }}
