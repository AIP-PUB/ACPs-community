services:
  registry_server:
    image: {{ acps_effective_image_tag }}
    working_dir: /opt/acps/app
    environment:
      ACPS_RUN_ENTRY: registry-server-api
      APP_ENV: production
    env_file:
      - {{ acps_runtime_root }}/config/registry_server/.env
    ports:
      - "{{ registry_server_public_port }}:9001"
    volumes:
      - {{ acps_runtime_root }}/config/registry_server:/opt/acps/app/config:ro,z
      - {{ acps_runtime_root }}/certs/registry_server:/certs:ro,z
      - {{ acps_data_root }}/registry_server/uploads:/data/uploads:z
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9001/health')"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    restart: unless-stopped
{% set _acps_extra_hosts = hostvars | acps_compose_extra_hosts(groups) %}
{% if _acps_extra_hosts %}
    extra_hosts:
{% for _eh in _acps_extra_hosts %}
      - "{{ _eh }}"
{% endfor %}
{% endif %}
    networks:
      - {{ acps_docker_network }}
{% if registry_server_enable_mtls_listener | bool %}
  registry_server_mtls:
    image: {{ acps_effective_image_tag }}
    working_dir: /opt/acps/app
    # registry-server-mtls must use python -m (builds CERT_REQUIRED TLS).
    # Until rebuilt images bake that into app-run, override the broken uvicorn entrypoint.
    command: ["python", "-m", "app.main_mtls"]
    environment:
      ACPS_RUN_ENTRY: registry-server-mtls
      APP_ENV: production
    env_file:
      - {{ acps_runtime_root }}/config/registry_server/.env
    ports:
      - "{{ registry_server_mtls_port }}:9002"
    volumes:
      - {{ acps_runtime_root }}/config/registry_server:/opt/acps/app/config:ro,z
      - {{ acps_runtime_root }}/certs/registry_server:/certs:ro,z
      - {{ acps_data_root }}/registry_server/uploads:/data/uploads:z
    restart: unless-stopped
{% set _acps_extra_hosts = hostvars | acps_compose_extra_hosts(groups) %}
{% if _acps_extra_hosts %}
    extra_hosts:
{% for _eh in _acps_extra_hosts %}
      - "{{ _eh }}"
{% endfor %}
{% endif %}
    networks:
      - {{ acps_docker_network }}
{% endif %}
