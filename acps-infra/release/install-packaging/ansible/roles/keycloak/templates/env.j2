KC_DB=postgres
{% if acps_deploy_mode == 'host' %}
{% set pg_connect_host = _pg_host | default('127.0.0.1') %}
JAVA_HOME={{ acps_keycloak_java_home }}
KC_DB_URL=jdbc:postgresql://{{ pg_connect_host }}:{{ postgresql_port }}/{{ keycloak_db_name }}
KC_DB_USERNAME={{ keycloak_db_user }}
KC_DB_PASSWORD={{ keycloak_db_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}
KC_HEALTH_ENABLED=true
KC_HTTP_ENABLED=true
KC_HTTP_PORT={{ keycloak_port }}
# Quarkus 管理/health 默认 9000，与 MinIO API / ClickHouse native 冲突（同机 all-in-one）。
KC_HTTP_MANAGEMENT_PORT={{ keycloak_management_port | default(9090) }}
KC_HOSTNAME=http://{{ _keycloak_hostname | default(acps_advertise_host | default(ansible_host) | default('localhost')) }}:{{ keycloak_port }}
KC_HOSTNAME_STRICT=false
KC_PROXY_HEADERS=xforwarded
KC_DATA_DIR={{ acps_data_root }}/keycloak
REGISTRY_WEB_BASE_URL=http://{{ _registry_host }}:{{ registry_server_public_port }}
MONITOR_WEB_BASE_URL=http://{{ _monitor_host }}:{{ monitor_server_port }}
LEADER_WEB_BASE_URL=http://{{ _leader_host }}:{{ demo_leader_web_port | default(9030) }}
{% else %}
{% set pg_connect_host = 'postgresql' if (inventory_hostname in (groups['postgresql'] | default([]))) else _pg_host %}
KC_DB_URL=jdbc:postgresql://{{ pg_connect_host }}:5432/{{ keycloak_db_name }}
KC_DB_USERNAME={{ keycloak_db_user }}
KC_DB_PASSWORD={{ keycloak_db_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}
KC_HEALTH_ENABLED=true
KC_HTTP_ENABLED=true
REGISTRY_WEB_BASE_URL=http://{{ _registry_host }}:{{ registry_server_public_port }}
MONITOR_WEB_BASE_URL=http://{{ _monitor_host }}:{{ monitor_server_port }}
LEADER_WEB_BASE_URL=http://{{ _leader_host }}:{{ demo_leader_web_port | default(9030) }}
{% endif %}
