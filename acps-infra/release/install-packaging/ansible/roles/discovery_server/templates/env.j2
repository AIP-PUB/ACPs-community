APP_ENV=production
ROOT_PATH=
{% set pg_connect_host = 'postgresql' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['postgresql'] | default([]))) else _pg_host %}
DATABASE_URL=postgresql+asyncpg://{{ discovery_db_user | acps_urlquote }}:{{ discovery_db_password | acps_urlquote }}@{{ pg_connect_host }}:{{ postgresql_port }}/{{ discovery_db_name }}
{% set reg = 'registry_server' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['registry_server'] | default([]))) else _registry_host %}
DSP_BASE_URL=http://{{ reg }}:{{ registry_server_public_port }}/acps-dsp-v2
DISCOVERY_MODE={{ discovery_server_variant }}
DISCOVERY_LLM_MODEL_NAME={{ discovery_llm_model_name }}
DISCOVERY_LLM_API_KEY={{ discovery_llm_api_key }}
DISCOVERY_LLM_BASE_URL={{ discovery_llm_base_url }}
EMBEDDING_MODEL_NAME={{ embedding_model_name }}
EMBEDDING_DIM={{ embedding_dim }}
EMBEDDING_API_KEY={{ embedding_api_key }}
EMBEDDING_BASE_URL={{ embedding_base_url }}
EMBEDDING_TIMEOUT={{ embedding_timeout | default('180') }}
DSP_SEMANTIC_INDEX_CONCURRENCY={{ dsp_semantic_index_concurrency | default('4') }}
DISCOVERY_SKIP_CPU_LLM={{ discovery_skip_cpu_llm | default('0') }}
DSP_WEBHOOK_SECRET={{ dsp_webhook_secret }}
DSP_WEBHOOK_RECEIVE_URL=http://127.0.0.1:{{ discovery_server_port }}/admin/dsp/webhooks/receive
FORWARDER_SERVER_ENABLED=false
{% if monitor_server_enabled | bool %}
{#Same secret as Monitor HEARTBEAT_SYNC_INTERNAL_TOKEN — H-compatible Keycloak path for D2.#}
ALIVE_SYNC_PROVIDER_BEARER_TOKEN={{ monitor_heartbeat_sync_internal_token }}
{% endif %}
