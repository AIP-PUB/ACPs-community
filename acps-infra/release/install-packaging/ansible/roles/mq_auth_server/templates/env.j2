APP_ENV=production
{% set redis_h = 'redis' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['redis'] | default([]))) else _redis_host %}
{% set rmq_h = 'rabbitmq' if (acps_deploy_mode == 'image' and inventory_hostname in (groups['rabbitmq'] | default([]))) else _rmq_host %}
{% if acps_deploy_mode == 'host' %}
{% set _certs_dir = acps_runtime_root ~ '/certs/mq_auth_server' %}
{% else %}
{% set _certs_dir = '/certs' %}
{% endif %}
REDIS_URL=rediss://:{{ redis_password | acps_urlquote }}@{{ redis_h }}:6379/0?ssl_ca_certs={{ _certs_dir }}/acps-root-ca.pem&ssl_cert_reqs=required&ssl_check_hostname=false
REDIS_TLS_CA_CERT={{ _certs_dir }}/acps-root-ca.pem
REDIS_TLS_CHECK_HOSTNAME=false
RABBITMQ_URL=amqps://{{ rabbitmq_user | acps_urlquote }}:{{ rabbitmq_password | acps_urlquote }}@{{ rmq_h }}:5671/
RABBITMQ_MGMT_URL=http://{{ rmq_h }}:15672
# Matches [rabbitmq].mgmt_user (default mq-auth-svc); password from secrets mq_auth_mgmt_pass.
RABBITMQ_MGMT_PASS={{ mq_auth_mgmt_pass }}
MQ_AUTH_MGMT_PASS={{ mq_auth_mgmt_pass }}
REGISTRY_BASE_URL=http://{{ _registry_host }}:{{ registry_server_public_port }}
TLS_CERT_FILE={{ _certs_dir }}/server.pem
TLS_KEY_FILE={{ _certs_dir }}/server.key
TLS_CA_CERT_FILE={{ _certs_dir }}/acps-root-ca.pem
CERTS_DIR={{ _certs_dir }}
