        "forwardFanoutLimit": 4,
        "forwardEachTimeoutMs": 100,
        "forwardTotalTimeoutMs": 200,
        "forwardChain": [
          "a",
          "b"
        ]
      },
      "overrides": null,
      "expected": {
        "getEffectiveDepthLimit": 5,
        "getEffectiveFanoutLimit": 4,
        "getEffectiveFanoutRemaining": 4,
        "getEffectiveEachTimeoutMs": 100,
        "getEffectiveTotalTimeoutMs": 200,
        "getForwardChainLength": 2
      }
    },
    {
      "name": "fanout remaining zero is kept",
      "input": {
        "query": "q",
        "forwardFanoutLimit": 3,
        "forwardFanoutRemaining": 0
      },
      "overrides": null,
      "expected": {
        "getEffectiveDepthLimit": 3,
        "getEffectiveFanoutLimit": 3,
        "getEffectiveFanoutRemaining": 0,
        "getEffectiveEachTimeoutMs": 10000,
        "getEffectiveTotalTimeoutMs": 60000,
        "getForwardChainLength": 0
      }
    },
    {
      "name": "fanout remaining falls back to limit",
      "input": {
        "query": "q",
        "forwardFanoutLimit": 3
      },
      "overrides": null,
      "expected": {
        "getEffectiveDepthLimit": 3,
        "getEffectiveFanoutLimit": 3,
        "getEffectiveFanoutRemaining": 3,
        "getEffectiveEachTimeoutMs": 10000,
        "getEffectiveTotalTimeoutMs": 60000,
        "getForwardChainLength": 0
      }
    },
    {
      "name": "empty chain",
      "input": {
        "query": "q",
        "forwardChain": []
      },
      "overrides": null,
      "expected": {
        "getEffectiveDepthLimit": 3,
        "getEffectiveFanoutLimit": 1,
        "getEffectiveFanoutRemaining": 1,
        "getEffectiveEachTimeoutMs": 10000,
        "getEffectiveTotalTimeoutMs": 60000,
        "getForwardChainLength": 0
      }
    },
    {
      "name": "zero values fall back to defaults",
      "input": {
        "query": "q"
      },
      "overrides": {
        "forwardDepthLimit": 0,
        "forwardFanoutLimit": 0,
        "forwardEachTimeoutMs": 0,
        "forwardTotalTimeoutMs": 0
